{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types"]
  },
  "include": ["montage/types.d.ts", "montage/**/*.js"],
  "exclude": ["montage/vendor/**", "montage/**/*.worker.js", "montage/sw.js"]
}
